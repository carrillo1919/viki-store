# Environment Variables for Viki-Store Server

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viki_store
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your_jwt_secret_key_for_development_testing
JWT_EXPIRES_IN=1h

# API Keys for Agents
AGENT_API_KEY=agent_api_key_for_development

# Redis (for rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Logs
LOG_LEVEL=info

# Telegram Bot (for admin)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# WhatsApp (if using external service)
WHATSAPP_API_KEY=your_whatsapp_api_key
